{
  "rewrites": [
    { "source": "/.well-known/assetlinks.json", "destination": "/api/assetlinks" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/send-notifications", "schedule": "0 19 * * *" },
    { "path": "/api/morning-briefs", "schedule": "0 13 * * *" }
  ]
}